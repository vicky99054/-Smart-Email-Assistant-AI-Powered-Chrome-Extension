{
  "name": "Email Writer Assistant",
  "description": "AI-powered email assistant to help you write better emails.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:8081/*", "*://mail.google.com/*"],
  "action": {
    "default_title": "Email Writer Assistant"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "css": ["content.css"],
      "matches": ["*://mail.google.com/*"],
     
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["*://mail.google.com/*"]
    }
  ]
}
