{
  "manifest_version": 3,
  "name": "Smart Email Assistant",
  "version": "1.0",

  "permissions": ["activeTab", "scripting"],

  "host_permissions": [
    "https://mail.google.com/*",
    "https://smart-email-backend-69hz.onrender.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"]
    }
  ]
}